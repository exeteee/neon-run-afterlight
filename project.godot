; NEON RUN: AFTERLIGHT
; Android-first 3D endless runner. Godot 4.7.2 / GDScript.
config_version=5

[application]
config/name="NEON RUN: AFTERLIGHT"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="An original offline neon-city endless runner."
config/icon="res://assets/icon.png"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/energy_saving/keep_screen_on=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.012, 0.02, 0.055, 1)
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1

[audio]
/default_bus_layout="res://default_bus_layout.tres"

[physics]
3d/default_gravity=24.0
